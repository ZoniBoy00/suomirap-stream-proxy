[Unit]
Description=Suomirap ICY stream proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=suomirap-proxy
Group=suomirap-proxy
WorkingDirectory=/opt/suomirap-stream-proxy
Environment=HOST=0.0.0.0
Environment=PORT=8443
Environment=PROXY_ALLOWED_ORIGINS=https://suomirap-redirect.vercel.app
Environment=PROXY_MAX_CONCURRENT=8
Environment=PROXY_MAX_MONTHLY_BYTES=800000000000
Environment=PROXY_STATE_FILE=/var/lib/suomirap-proxy/usage.json
LoadCredential=fullchain.pem:/etc/letsencrypt/live/suomirap-proxy-ip/fullchain.pem
LoadCredential=privkey.pem:/etc/letsencrypt/live/suomirap-proxy-ip/privkey.pem
ExecStart=/usr/bin/node /opt/suomirap-stream-proxy/src/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
MemoryMax=192M
CPUQuota=50%
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/suomirap-stream-proxy
ReadWritePaths=/var/lib/suomirap-proxy

[Install]
WantedBy=multi-user.target
